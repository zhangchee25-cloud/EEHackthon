# Copy to backend/.env. Never commit or share the real .env file.
MODEL_BASE_URL=https://your-activity-api.example/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_STYLE=responses
MODEL_JSON_MODE=false
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=2200
HOST=127.0.0.1
PORT=8000
MAX_FILE_MB=100
PDF_PARSE_TIMEOUT_SECONDS=120
# PDF 页数不限；旧 MAX_PDF_PAGES 配置不再生效。
MAX_CONTEXT_CHARS=45000
# DATA_DIR=C:/path/to/private/data
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# School login: Windows defaults to installed Edge; macOS uses Playwright Chromium.
# Optional absolute executable path; paths containing spaces are accepted.
# LEARN_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# LEARN_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

